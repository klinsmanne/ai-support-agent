{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]{2,40}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "industry": {
      "type": "string",
      "enum": [
        "ecommerce",
        "saas",
        "other"
      ]
    },
    "settings": {
      "type": "object",
      "properties": {
        "rollout_mode": {
          "default": "shadow",
          "type": "string",
          "enum": [
            "shadow",
            "draft_only",
            "auto_send"
          ]
        },
        "refund_auto_approve_limit_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "max_refunds_per_customer_30d": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "escalate_on_negative_sentiment_below": {
          "type": "number",
          "minimum": -1,
          "maximum": 0
        },
        "min_confidence_to_act": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "enabled_tools": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "get_customer",
              "get_orders",
              "get_ticket_history",
              "search_knowledge_base",
              "issue_refund",
              "update_order",
              "send_reply",
              "escalate_to_human"
            ]
          }
        },
        "brand_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\r\\n]+$"
        },
        "brand_voice": {
          "type": "string",
          "minLength": 10,
          "maxLength": 600
        },
        "supported_languages": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          }
        },
        "allowed_link_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
          }
        },
        "support_email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "csat_enabled": {
          "default": true,
          "type": "boolean"
        },
        "daily_ticket_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_ai_replies_per_thread": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "retention_days": {
          "type": "integer",
          "minimum": 7,
          "maximum": 3650
        }
      },
      "required": [
        "refund_auto_approve_limit_cents",
        "max_refunds_per_customer_30d",
        "escalate_on_negative_sentiment_below",
        "min_confidence_to_act",
        "enabled_tools",
        "brand_name",
        "brand_voice",
        "supported_languages",
        "allowed_link_domains",
        "daily_ticket_cap",
        "max_ai_replies_per_thread",
        "retention_days"
      ],
      "additionalProperties": false
    },
    "customers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$"
          },
          "preferred_language": {
            "default": "en",
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "plan": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "email",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order_number": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{3,20}$"
          },
          "customer": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "shipped",
              "delayed",
              "delivered",
              "cancelled",
              "returned"
            ]
          },
          "currency": {
            "default": "USD",
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "total_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "price_cents": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "final_sale": {
                  "type": "boolean"
                }
              },
              "required": [
                "sku",
                "name",
                "qty",
                "price_cents"
              ],
              "additionalProperties": false
            }
          },
          "carrier": {
            "type": "string"
          },
          "tracking_number": {
            "type": "string"
          },
          "placed_days_ago": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "shipped_days_ago": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "delivered_days_ago": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "estimated_delivery_in_days": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "duplicate_charge": {
            "type": "boolean"
          },
          "shipping_address": {
            "type": "object",
            "properties": {
              "line1": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "postal_code": {
                "type": "string"
              },
              "country": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2
              }
            },
            "required": [
              "line1",
              "city",
              "postal_code",
              "country"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "order_number",
          "customer",
          "status",
          "total_cents",
          "items",
          "placed_days_ago"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "slug",
    "name",
    "industry",
    "settings",
    "customers",
    "orders"
  ],
  "additionalProperties": false
}
