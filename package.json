{
  "name": "support-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "seed:build": "tsx scripts/build-seed.ts",
    "secrets": "node scripts/secrets.mjs",
    "llm:smoke": "tsx scripts/llm-smoke.ts",
    "kb:embed": "tsx scripts/kb-embed.ts",
    "agent:try": "tsx scripts/agent-try.ts",
    "kb:search": "tsx scripts/kb-search.ts",
    "gmail:auth": "tsx scripts/gmail-auth.ts",
    "email:poll": "tsx --conditions=react-server scripts/email-poll.ts",
    "email:unspam": "tsx --conditions=react-server scripts/email-unspam.ts",
    "dashboard:users": "tsx scripts/setup-dashboard-users.ts",
    "eval": "tsx evals/run.ts",
    "eval:report": "tsx evals/report.ts",
    "eval:gate": "tsx evals/gate.ts",
    "e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.16",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
