# Copy to .env.local and fill in. Never commit real values.
# Model provider: gemini | groq | anthropic (Groq is the automatic fallback)
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: activates the Claude adapter
ANTHROPIC_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
