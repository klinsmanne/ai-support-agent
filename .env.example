# Local values are generated from the macOS Keychain: `node scripts/secrets.mjs sync`.
# Never commit real values. Names must match scripts/secrets.mjs and src/lib/env.ts.

# Model provider: gemini | groq | anthropic (Groq is the automatic fallback)
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: activates the Claude adapter
ANTHROPIC_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Random 32+ byte hex strings
CRON_SECRET=
CSRF_SECRET=

# Gmail channel (OAuth)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SUPPORT_EMAIL_ADDRESS=
ALERT_EMAIL=

# Cloudflare Turnstile (chat widget bot protection)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
